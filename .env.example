# Copy this file to .env and fill in the values. .env is never committed (.gitignore).
# Token: airtable.com/create/tokens  (scopes: data.records:read; for the one-time seed also
# data.records:write, schema.bases:read, schema.bases:write)
AIRTABLE_TOKEN=your-token-here
# Base ID: the part of the base URL that starts with "app"  (airtable.com/appXXXXXXXXXXXXXX/...)
AIRTABLE_BASE_ID=your-base-id-here
